# SightKick browser build, served as a static site by nginx.

FROM node:20-slim AS build
WORKDIR /app
RUN corepack enable

# Dependencies first so they're cached across source changes. Skipping
# builds avoids downloading Electron and compiling native modules, which the
# web build doesn't use.
COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn/releases .yarn/releases
RUN yarn install --immutable --mode=skip-build

COPY tsconfig.json vite.web.config.ts ./
COPY scripts/build-info.ts scripts/
COPY assets assets
COPY src src
# The commit shown in the app and in /version.json. The build context has no
# .git, so it comes in as a build arg: SK_COMMIT for a manual build
# (docker compose passes it through), HARBOR_SOURCE_COMMIT from Harbor.
ARG SK_COMMIT=""
ARG HARBOR_SOURCE_COMMIT=""
ENV SK_COMMIT=${SK_COMMIT} HARBOR_SOURCE_COMMIT=${HARBOR_SOURCE_COMMIT}
# Default stem server address baked into the app. "/stem-api" is proxied by
# this image's nginx when SK_STEM_UPSTREAM is set at run time; users can still
# point the app elsewhere in its settings.
ARG SK_STEM_SERVER_URL=/stem-api
ENV SK_STEM_SERVER_URL=${SK_STEM_SERVER_URL}
RUN yarn build:web

FROM nginx:1.27-alpine
COPY --from=build /app/out/web /usr/share/nginx/html
COPY docker/web/default.conf /etc/nginx/conf.d/default.conf
COPY docker/web/40-sightkick-stem-proxy.sh /docker-entrypoint.d/
# Proxy target for /stem-api/, e.g. http://stem-server:8765. Unset: no proxy.
ENV SK_STEM_UPSTREAM=""
EXPOSE 80
